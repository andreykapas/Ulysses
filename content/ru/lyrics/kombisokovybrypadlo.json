{
  "title": "Комбисоковыбрипадло",
  "type": "poem",
  "date": "2026-08-05",
  "section": "lyrics",
  "text": [
    [
      "Абрушательный кальсо-о",
      "Нипрастой, а украшенье.",
      "Дух сыр бешеный решенъя",
      "Абрушательный кальсо-о"
    ],
    [
      "Комбисоковыбрипадло",
      "Он как белый, но зелёный",
      "Он наветренный и спелый",
      "Абрушательный кальсо)))"
    ]
  ]
}
